	list wan_proxy_ipv4_ips '185.76.151.0/24'
	list wan_proxy_ipv4_ips '203.208.50.66/32'
	list listen_interfaces 'eth0'
	option bind_interface 'eth0'

config homeproxy 'routing'
	option sniff_override '1'
	option default_outbound 'Final'
	option default_outbound_dns 'default-dns'
	option bypass_cn_traffic '1'
	option domain_strategy 'prefer_ipv4'

config homeproxy 'dns'
	option dns_strategy 'prefer_ipv4'
	option default_server 'mosdns'
	option disable_cache '1'
	option default_strategy 'prefer_ipv4'

config homeproxy 'subscription'
	option auto_update '1'
	option allow_insecure '0'
	option packet_encoding 'xudp'
	option update_via_proxy '0'
	option filter_nodes 'disabled'
	option auto_update_time '2'

config homeproxy 'server'
	option enabled '0'
	option log_level 'warn'
	option log_enabled '0'

config node 'a59d2e7dcfa669c4eb6e9fabd8846380'
	option label 'us'
	option type 'vmess'
	option address 'www.example.top'
	option port '443'
	option uuid 'e3fbff9e-5dcc-4412-85bf-3f421a8b1287'
	option vmess_alterid '0'
	option vmess_encrypt 'auto'
	option transport 'ws'
	option tls '1'
	option tls_sni 'www.example.top'
