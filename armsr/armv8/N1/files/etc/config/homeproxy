config routing_node 'Final'
	option label 'Final'
	option enabled '1'
	option node 'a59d2e7dcfa669c4eb6e9fabd8846380'
	option bind_interface 'eth0'

config routing_rule 'route_reject'
	option label 'route_reject'
	option enabled '1'
	option mode 'default'
	list protocol 'quic'
	option action 'reject'
	option reject_method 'default'

config ruleset 'geosite_private'
	option label 'geosite_private'
	option enabled '1'
	option type 'remote'
	option format 'binary'
	option url 'https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs'
	option update_interval '1d'

config ruleset 'geosite_cn'
	option label 'geosite_cn'
	option enabled '1'
	option type 'remote'
	option format 'binary'
	option url 'https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs'
	option update_interval '1d'

config ruleset 'geoip_cn'
	option label 'geoip_cn'
	option enabled '1'
	option type 'remote'
	option format 'binary'
	option url 'https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs'
	option update_interval '1d'

config routing_rule 'route_direct'
	option label 'route_direct'
	option enabled '1'
	option mode 'default'
	list rule_set 'geosite_private'
	list rule_set 'geosite_cn'
	list rule_set 'geoip_cn'
	option action 'route'
	option outbound 'direct-out'

config dns_server 'mosdns'
	option label 'mosdns'
	option enabled '1'
	option type 'udp'
	option server '127.0.0.1'
	option server_port '5335'
	option outbound 'direct-out'
